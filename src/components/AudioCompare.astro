---
interface Props {
  title: string;
  description?: string;
  inputAudio: string;
  outputAudio: string;
  inputLabel?: string;
  outputLabel?: string;
}

const {
  title,
  description,
  inputAudio,
  outputAudio,
  inputLabel = 'Input (Atypical Speech)',
  outputLabel = 'Output (Restored)',
} = Astro.props;

const uniqueId = 'ac-' + Math.random().toString(36).substring(2, 9);
---

<div class="my-5 p-4 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-neutral-50/70 dark:bg-neutral-900/50 text-sm" id={uniqueId}>
  <div class="flex items-center justify-between mb-2">
    <span class="font-medium text-neutral-900 dark:text-neutral-100">{title}</span>
    <span class="font-mono text-xs text-neutral-400 dark:text-neutral-500">A/B comparison</span>
  </div>

  {description && (
    <p class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 mb-3.5 leading-relaxed">
      {description}
    </p>
  )}

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
    <!-- Input Audio Track -->
    <div class="custom-audio-card p-3 rounded-lg border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-950/80 flex flex-col justify-between">
      <div class="flex items-center justify-between mb-2">
        <span class="text-xs font-mono text-neutral-500 dark:text-neutral-400 truncate pr-2">
          {inputLabel}
        </span>
        <span class="audio-time text-[11px] font-mono text-neutral-400 dark:text-neutral-500 shrink-0">
          0:00
        </span>
      </div>

      <div class="flex items-center gap-2.5">
        <button
          type="button"
          class="play-btn w-8 h-8 rounded-full flex items-center justify-center bg-neutral-100 dark:bg-neutral-800 hover:bg-neutral-200 dark:hover:bg-neutral-700 text-neutral-800 dark:text-neutral-200 transition-transform active:scale-95 shrink-0 cursor-pointer"
          aria-label="Play input audio"
        >
          <!-- Play Icon -->
          <svg class="play-icon w-3.5 h-3.5 fill-current ml-0.5" viewBox="0 0 24 24">
            <polygon points="5 3 19 12 5 21 5 3"></polygon>
          </svg>
          <!-- Pause Icon -->
          <svg class="pause-icon w-3.5 h-3.5 fill-current hidden" viewBox="0 0 24 24">
            <rect x="6" y="4" width="4" height="16"></rect>
            <rect x="14" y="4" width="4" height="16"></rect>
          </svg>
        </button>

        <!-- Progress Bar Track -->
        <div class="progress-container flex-grow h-2 bg-neutral-100 dark:bg-neutral-800 rounded-full cursor-pointer relative overflow-hidden">
          <div class="progress-bar h-full bg-neutral-800 dark:bg-neutral-200 rounded-full w-0 transition-all duration-75"></div>
        </div>
      </div>

      <audio preload="metadata" src={inputAudio} class="hidden raw-audio"></audio>
    </div>

    <!-- Output Audio Track -->
    <div class="custom-audio-card p-3 rounded-lg border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-950/80 flex flex-col justify-between">
      <div class="flex items-center justify-between mb-2">
        <span class="text-xs font-mono text-neutral-800 dark:text-neutral-200 font-medium truncate pr-2">
          {outputLabel}
        </span>
        <span class="audio-time text-[11px] font-mono text-neutral-400 dark:text-neutral-500 shrink-0">
          0:00
        </span>
      </div>

      <div class="flex items-center gap-2.5">
        <button
          type="button"
          class="play-btn w-8 h-8 rounded-full flex items-center justify-center bg-neutral-900 text-white dark:bg-neutral-100 dark:text-neutral-900 hover:opacity-90 transition-transform active:scale-95 shrink-0 cursor-pointer"
          aria-label="Play output audio"
        >
          <!-- Play Icon -->
          <svg class="play-icon w-3.5 h-3.5 fill-current ml-0.5" viewBox="0 0 24 24">
            <polygon points="5 3 19 12 5 21 5 3"></polygon>
          </svg>
          <!-- Pause Icon -->
          <svg class="pause-icon w-3.5 h-3.5 fill-current hidden" viewBox="0 0 24 24">
            <rect x="6" y="4" width="4" height="16"></rect>
            <rect x="14" y="4" width="4" height="16"></rect>
          </svg>
        </button>

        <!-- Progress Bar Track -->
        <div class="progress-container flex-grow h-2 bg-neutral-100 dark:bg-neutral-800 rounded-full cursor-pointer relative overflow-hidden">
          <div class="progress-bar h-full bg-neutral-900 dark:bg-neutral-100 rounded-full w-0 transition-all duration-75"></div>
        </div>
      </div>

      <audio preload="metadata" src={outputAudio} class="hidden raw-audio"></audio>
    </div>
  </div>
</div>

<script is:inline>
  function setupCustomAudio() {
    const cards = document.querySelectorAll('.custom-audio-card');
    const allAudios = document.querySelectorAll('audio.raw-audio');

    function formatTime(seconds) {
      if (isNaN(seconds)) return '0:00';
      const mins = Math.floor(seconds / 60);
      const secs = Math.floor(seconds % 60);
      return `${mins}:${secs < 10 ? '0' : ''}${secs}`;
    }

    cards.forEach((card) => {
      const audio = card.querySelector('audio.raw-audio');
      const playBtn = card.querySelector('.play-btn');
      const playIcon = card.querySelector('.play-icon');
      const pauseIcon = card.querySelector('.pause-icon');
      const progressBar = card.querySelector('.progress-bar');
      const progressContainer = card.querySelector('.progress-container');
      const timeDisplay = card.querySelector('.audio-time');

      if (!audio || !playBtn) return;

      // Update duration when metadata loads
      audio.addEventListener('loadedmetadata', () => {
        if (timeDisplay) timeDisplay.textContent = `0:00 / ${formatTime(audio.duration)}`;
      });

      function pauseThis() {
        audio.pause();
        playIcon.classList.remove('hidden');
        pauseIcon.classList.add('hidden');
      }

      function playThis() {
        // Pause all other audio players on page
        allAudios.forEach((other) => {
          if (other !== audio && !other.paused) {
            other.pause();
            const otherCard = other.closest('.custom-audio-card');
            if (otherCard) {
              otherCard.querySelector('.play-icon')?.classList.remove('hidden');
              otherCard.querySelector('.pause-icon')?.classList.add('hidden');
            }
          }
        });

        audio.play().catch(() => {});
        playIcon.classList.add('hidden');
        pauseIcon.classList.remove('hidden');
      }

      playBtn.addEventListener('click', () => {
        if (audio.paused) {
          playThis();
        } else {
          pauseThis();
        }
      });

      // Time update
      audio.addEventListener('timeupdate', () => {
        if (!isNaN(audio.duration) && audio.duration > 0) {
          const pct = (audio.currentTime / audio.duration) * 100;
          if (progressBar) progressBar.style.width = `${pct}%`;
          if (timeDisplay) {
            timeDisplay.textContent = `${formatTime(audio.currentTime)} / ${formatTime(audio.duration)}`;
          }
        }
      });

      // Ended
      audio.addEventListener('ended', () => {
        pauseThis();
        if (progressBar) progressBar.style.width = '0%';
        if (timeDisplay) timeDisplay.textContent = `0:00 / ${formatTime(audio.duration)}`;
      });

      // Click to seek
      if (progressContainer) {
        progressContainer.addEventListener('click', (e) => {
          const rect = progressContainer.getBoundingClientRect();
          const clickX = e.clientX - rect.left;
          const pct = Math.max(0, Math.min(1, clickX / rect.width));
          if (!isNaN(audio.duration)) {
            audio.currentTime = pct * audio.duration;
            if (progressBar) progressBar.style.width = `${pct * 100}%`;
          }
        });
      }
    });
  }

  setupCustomAudio();
  document.addEventListener('astro:after-swap', setupCustomAudio);
</script>
