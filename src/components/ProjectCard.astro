---
interface Props {
  title: string;
  description: string;
  techStack: string[];
  githubUrl?: string;
  demoUrl?: string;
  blogUrl?: string;
  status?: string;
  highlights?: string[];
}

const {
  title,
  description,
  techStack,
  githubUrl,
  demoUrl,
  blogUrl,
  status = 'Open Source',
  highlights = [],
} = Astro.props;

const tagsJson = JSON.stringify(techStack);
---

<article class="project-item py-5 transition-opacity duration-150" data-tech={tagsJson}>
  <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 mb-1.5">
    <h3 class="text-base sm:text-lg font-medium text-neutral-900 dark:text-neutral-100 leading-snug">
      {githubUrl ? (
        <a href={githubUrl} target="_blank" rel="noopener noreferrer" class="hover:underline">
          {title} ↗
        </a>
      ) : (
        title
      )}
    </h3>
    <span class="text-xs font-mono text-neutral-400 dark:text-neutral-500 shrink-0">
      {status}
    </span>
  </div>

  <p class="text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed mb-2.5">
    {description}
  </p>

  <div class="flex flex-wrap items-center gap-x-3 gap-y-1.5 text-xs font-mono text-neutral-500 dark:text-neutral-400">
    {techStack.map((tech) => (
      <button
        type="button"
        class="project-tag-btn cursor-pointer hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors"
        data-tech={tech}
      >
        #{tech}
      </button>
    ))}
    {blogUrl && (
      <a href={blogUrl} class="text-neutral-800 dark:text-neutral-200 hover:underline ml-auto font-sans text-sm font-medium">
        writeup →
      </a>
    )}
  </div>
</article>
