      <a
        href="https://github.com/Yash-Kumar-tech"
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors"
      >
        github ↗
      </a>
      <a
        href="https://scholar.google.com/citations?user=8hnxehIAAAAJ&hl=en"
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors"
      >
        scholar ↗
      </a>
      <a
        href="mailto:yash.sonkar@research.iiit.ac.in"
        class="hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors"
