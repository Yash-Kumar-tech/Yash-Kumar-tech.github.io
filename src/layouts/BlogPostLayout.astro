---
import BaseLayout from './BaseLayout.astro';
import SeriesBox from '../components/SeriesBox.astro';

interface SeriesPostItem {
  title: string;
  slug: string;
  order: number;
}

interface SeriesInfo {
  name: string;
  order: number;
}

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags?: string[];
  category?: string;
  readingTime?: string;
  series?: SeriesInfo;
  seriesPosts?: SeriesPostItem[];
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  tags = [],
  category = 'Engineering',
  readingTime = '6 min read',
  series,
  seriesPosts = [],
} = Astro.props;

const formattedDate = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(pubDate);

const prevPost = series
  ? seriesPosts.find((p) => p.order === series.order - 1)
  : null;
const nextPost = series
  ? seriesPosts.find((p) => p.order === series.order + 1)
  : null;
---

<BaseLayout title={title} description={description} type="article">
  <article class="max-w-2xl mx-auto">
    <!-- Back button -->
    <a
      href="/blog"
      class="inline-flex items-center text-xs text-neutral-500 hover:text-neutral-900 dark:hover:text-neutral-100 mb-6 transition-colors"
    >
      ← back to blog
    </a>

    <!-- Header -->
    <header class="mb-8">
      <h1 class="text-2xl font-medium tracking-tight text-neutral-900 dark:text-neutral-100 mb-2">
        {title}
      </h1>

      <div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs font-mono text-neutral-500 dark:text-neutral-400">
        <time datetime={pubDate.toISOString()}>{formattedDate}</time>
        <span>•</span>
        <span>{readingTime}</span>
        {tags.length > 0 && (
          <>
            <span>•</span>
            <span class="inline-flex flex-wrap gap-1.5">
              {tags.map((t) => (
                <a
                  href={`/blog?tag=${encodeURIComponent(t)}`}
                  class="hover:text-neutral-900 dark:hover:text-neutral-100 hover:underline"
                >
                  #{t}
                </a>
              ))}
            </span>
          </>
        )}
      </div>
    </header>

    <!-- Series Box -->
    {series && seriesPosts.length > 1 && (
      <SeriesBox
        seriesName={series.name}
        currentOrder={series.order}
        seriesPosts={seriesPosts}
      />
    )}

    <!-- Content -->
    <div class="prose prose-neutral dark:prose-invert max-w-none text-sm leading-relaxed">
      <slot />
    </div>

    <!-- Series Next / Previous Navigation -->
    {series && (prevPost || nextPost) && (
      <nav aria-label="Series Navigation" class="mt-12 pt-6 border-t border-neutral-200 dark:border-neutral-800 grid grid-cols-1 sm:grid-cols-2 gap-4">
        {prevPost ? (
          <a
            href={`/blog/${prevPost.slug}`}
            class="p-3.5 rounded-lg border border-neutral-200 dark:border-neutral-800 bg-neutral-50/60 dark:bg-neutral-900/40 hover:border-neutral-400 dark:hover:border-neutral-600 transition-colors group"
          >
            <span class="block text-[11px] font-mono uppercase tracking-wider text-neutral-400 dark:text-neutral-500 mb-1">
              ← Previous in Series
            </span>
            <span class="text-sm font-medium text-neutral-800 dark:text-neutral-200 group-hover:text-neutral-900 dark:group-hover:text-neutral-100">
              {prevPost.title}
            </span>
          </a>
        ) : <div />}

        {nextPost ? (
          <a
            href={`/blog/${nextPost.slug}`}
            class="p-3.5 rounded-lg border border-neutral-200 dark:border-neutral-800 bg-neutral-50/60 dark:bg-neutral-900/40 hover:border-neutral-400 dark:hover:border-neutral-600 transition-colors text-right group ml-auto w-full"
          >
            <span class="block text-[11px] font-mono uppercase tracking-wider text-neutral-400 dark:text-neutral-500 mb-1">
              Next in Series →
            </span>
            <span class="text-sm font-medium text-neutral-800 dark:text-neutral-200 group-hover:text-neutral-900 dark:group-hover:text-neutral-100">
              {nextPost.title}
            </span>
          </a>
        ) : <div />}
      </nav>
    )}

    <!-- Post Footer -->
    <footer class="mt-12 pt-6 border-t border-neutral-200 dark:border-neutral-800 text-xs text-neutral-500 flex justify-between items-center">
      <span>Yash Sonkar — Speech AI & Systems</span>
      <a
        href="https://github.com/Yash-Kumar-tech"
        target="_blank"
        rel="noopener noreferrer"
        class="hover:underline"
      >
        discuss on github ↗
      </a>
    </footer>
  </article>

  <!-- Reading Progress Bar -->
  <div id="reading-progress" class="fixed top-0 left-0 h-[2px] bg-neutral-800 dark:bg-neutral-200 z-50 transition-all duration-75 w-0"></div>

  <!-- Back to top button -->
  <button
    id="back-to-top"
    type="button"
    class="fixed bottom-6 right-6 w-9 h-9 rounded-full border border-neutral-200 dark:border-neutral-800 bg-white/90 dark:bg-neutral-900/90 text-neutral-500 hover:text-neutral-900 dark:hover:text-neutral-100 backdrop-blur shadow-sm opacity-0 pointer-events-none transition-all duration-200 z-30 flex items-center justify-center cursor-pointer"
    aria-label="Back to top"
  >
    <svg class="w-4 h-4 stroke-current" fill="none" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18"></path>
    </svg>
  </button>
</BaseLayout>

<script is:inline>
  function setupArticleInteractions() {
    // 1. Reading Progress & Back to Top
    const progressBar = document.getElementById('reading-progress');
    const backToTopBtn = document.getElementById('back-to-top');

    function updateProgress() {
      const scrollY = window.scrollY || document.documentElement.scrollTop;
      const docHeight = document.documentElement.scrollHeight - document.documentElement.clientHeight;
      if (docHeight > 0 && progressBar) {
        const pct = Math.min(100, Math.max(0, (scrollY / docHeight) * 100));
        progressBar.style.width = `${pct}%`;
      }

      if (backToTopBtn) {
        if (scrollY > 300) {
          backToTopBtn.classList.remove('opacity-0', 'pointer-events-none');
          backToTopBtn.classList.add('opacity-100');
        } else {
          backToTopBtn.classList.add('opacity-0', 'pointer-events-none');
          backToTopBtn.classList.remove('opacity-100');
        }
      }
    }

    window.addEventListener('scroll', updateProgress, { passive: true });
    updateProgress();

    if (backToTopBtn) {
      backToTopBtn.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    }

    // 2. Injected Code Block Copy Buttons
    document.querySelectorAll('pre.astro-code').forEach((pre) => {
      // Check if button already injected
      if (pre.querySelector('.code-copy-btn')) return;

      pre.style.position = 'relative';

      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className =
        'code-copy-btn absolute top-2 right-2 px-2 py-0.5 text-[11px] font-mono text-neutral-400 hover:text-neutral-200 bg-neutral-800/80 hover:bg-neutral-700/80 rounded border border-neutral-700/60 transition-colors cursor-pointer';
      btn.textContent = 'copy';

      btn.addEventListener('click', async () => {
        const code = pre.querySelector('code');
        const text = code ? code.innerText : pre.innerText;
        try {
          await navigator.clipboard.writeText(text);
          btn.textContent = 'copied ✓';
          setTimeout(() => {
            btn.textContent = 'copy';
          }, 2000);
        } catch (err) {
          console.error(err);
        }
      });

      pre.appendChild(btn);
    });
  }

  setupArticleInteractions();
  document.addEventListener('astro:after-swap', setupArticleInteractions);
</script>
