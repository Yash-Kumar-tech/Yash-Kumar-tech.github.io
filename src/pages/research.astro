---
import BaseLayout from "../layouts/BaseLayout.astro";
import PubCard from "../components/PubCard.astro";
import { getCollection } from "astro:content";

const allPubs = await getCollection("publications");
const sortedPubs = allPubs.sort((a, b) => b.data.year - a.data.year);
---

<BaseLayout
  title="Research"
  description="Publications and research projects by Yash Sonkar at IIIT Hyderabad."
>
  <div class="space-y-8">
    <header class="mb-6">
      <h1
        class="text-3xl font-medium tracking-tight text-neutral-900 dark:text-neutral-100 mb-3"
      >
        research
      </h1>
      <p
        class="text-sm sm:text-base text-neutral-600 dark:text-neutral-400 leading-relaxed"
      >
        My doctoral research at the Center for Visual Information Technology
        (CVIT), IIIT Hyderabad explores real-time generative models for atypical
        speech restoration, discrete acoustic unit representations, and silent
        speech interfaces from tongue ultrasound videos.
      </p>
    </header>

    <div class="divide-y divide-neutral-100 dark:divide-neutral-900">
      {
        sortedPubs.map((pub) => (
          <PubCard
            title={pub.data.title}
            authors={pub.data.authors}
            venue={pub.data.venue}
            year={pub.data.year}
            paperUrl={pub.data.paperUrl}
            projectUrl={pub.data.projectUrl}
            codeUrl={pub.data.codeUrl}
            bibtex={pub.data.bibtex}
            highlightNote={pub.data.highlightNote}
            audioComparison={pub.data.audioComparison}
          />
        ))
      }
    </div>
  </div>
</BaseLayout>
