---
interface SeriesPostItem {
  title: string;
  slug: string;
  order: number;
}

interface Props {
  seriesName: string;
  currentOrder: number;
  seriesPosts: SeriesPostItem[];
}

const { seriesName, currentOrder, seriesPosts } = Astro.props;
const totalParts = seriesPosts.length;
---

<div class="my-6 p-4 rounded-lg border border-neutral-200 dark:border-neutral-800 bg-neutral-50/70 dark:bg-neutral-900/50">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1 mb-3 pb-2.5 border-b border-neutral-200/80 dark:border-neutral-800/80">
    <div class="flex items-center gap-2">
      <span class="px-2 py-0.5 text-[11px] font-mono uppercase tracking-wider bg-neutral-200 dark:bg-neutral-800 text-neutral-700 dark:text-neutral-300 rounded font-medium">
        Series
      </span>
      <span class="font-medium text-sm text-neutral-900 dark:text-neutral-100">
        {seriesName}
      </span>
    </div>
    <span class="text-xs font-mono text-neutral-500 dark:text-neutral-400">
      Part {currentOrder} of {totalParts}
    </span>
  </div>

  <ol class="space-y-1.5 text-xs sm:text-sm">
    {
      seriesPosts.map((post) => {
        const isCurrent = post.order === currentOrder;
        return (
          <li class="flex items-baseline gap-2.5">
            <span
              class={`font-mono text-xs w-4 shrink-0 ${
                isCurrent
                  ? 'text-neutral-900 dark:text-neutral-100 font-semibold'
                  : 'text-neutral-400 dark:text-neutral-500'
              }`}
            >
              {post.order}.
            </span>
            {isCurrent ? (
              <span class="text-neutral-900 dark:text-neutral-100 font-medium">
                {post.title} <span class="text-xs font-mono text-neutral-400 dark:text-neutral-500 font-normal">(current)</span>
              </span>
            ) : (
              <a
                href={`/blog/${post.slug}`}
                class="text-neutral-600 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-neutral-100 hover:underline transition-colors"
              >
                {post.title}
              </a>
            )}
          </li>
        );
      })
    }
  </ol>
</div>
